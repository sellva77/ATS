generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ResumeDocument {
  id           String         @id @default(uuid())

  bucket       String
  objectKey    String         @unique

  originalName String
  mimeType     String
  fileSize     BigInt

  status       DocumentStatus @default(UPLOADED)

  profile      CandidateProfile?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED
}

model CandidateProfile {
  id         String @id @default(uuid())
  documentId String @unique

  profile    Json
  rawText    String?
  version    Int @default(1)

  /// Deterministically calculated from the experience[] array.
  /// Stored here for fast recruiter filters (e.g. ≥5 years) without
  /// needing to parse the JSON profile on every query.
  totalExperienceYears Float?

  document ResumeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}