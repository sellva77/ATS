generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED
}

enum CandidateStatus {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  HIRED
}

// ── Organization ─────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique

  users      User[]
  teams      Team[]
  roles      Role[]
  candidates CandidateProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Roles & Permissions ──────────────────────────────────────

model Role {
  id             String        @id @default(uuid())
  name           String
  description    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users          User[]
  permissions    RolePermission[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([name, organizationId]) // Ensure role names are unique per org (or globally if orgId is null)
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?

  roles       RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ── Team ─────────────────────────────────────────────────────

model Team {
  id             String       @id @default(uuid())
  name           String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users          User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── User ─────────────────────────────────────────────────────

model User {
  id       String  @id @default(uuid())
  name     String?
  email    String  @unique
  password String
  phone    String?
  
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])

  /// Null for platform-level ADMIN (no org)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// Null when user has not been assigned to a specific team
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  /// Candidates this user manages (Team Manager)
  managedCandidates CandidateProfile[] @relation("AssignedManager")

  /// Candidates this user originally created/uploaded
  createdCandidates  CandidateProfile[] @relation("CreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── ResumeDocument ───────────────────────────────────────────

model ResumeDocument {
  id           String         @id @default(uuid())

  bucket       String
  objectKey    String         @unique

  originalName String
  mimeType     String
  fileSize     BigInt

  status       DocumentStatus @default(UPLOADED)

  profile      CandidateProfile?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ── CandidateProfile ─────────────────────────────────────────

model CandidateProfile {
  id         String @id @default(uuid())
  documentId String @unique

  profile    Json
  rawText    String?
  version    Int @default(1)

  /// Deterministically calculated from the experience[] array.
  /// Stored here for fast recruiter filters (e.g. ≥5 years) without
  /// needing to parse the JSON profile on every query.
  totalExperienceYears Float?

  /// Candidate workflow status
  status     CandidateStatus @default(NEW)

  /// Organization that owns this candidate record.
  /// Null only for candidates uploaded before multi-tenancy was introduced.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// The Team Manager currently responsible for this candidate.
  assignedManagerId String?
  assignedManager   User?   @relation("AssignedManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)

  /// The user who originally uploaded and processed this candidate.
  createdById String?
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  document ResumeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}