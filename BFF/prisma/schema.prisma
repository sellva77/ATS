generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ResumeDocument {
  id         String   @id @default(uuid())

  bucket     String
  objectKey  String

  fileName   String
  mimeType   String
  fileSize   BigInt

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}